{
    "info": {
        "name": "Addressing API",
        "description": "Current standalone Addressing API examples; canonical contract: openapi/address.yaml",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Create Address",
            "request": {
                "method": "POST",
                "header": [{"key": "Content-Type", "value": "application/json"}],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"ownerId\": \"demo-owner\",\n  \"line1\": \"1 Khreshchatyk Street\",\n  \"city\": \"Kyiv\",\n  \"region\": \"Kyiv\",\n  \"postalCode\": \"01001\",\n  \"country\": \"UA\"\n}"
                },
                "url": "http://localhost:8000/api/address"
            }
        },
        {
            "name": "Get Address by ID",
            "request": {
                "method": "GET",
                "url": "http://localhost:8000/api/address/demo-0001?ownerId=demo-owner"
            }
        },
        {
            "name": "Search Addresses",
            "request": {
                "method": "GET",
                "url": "http://localhost:8000/api/address/search?ownerId=demo-owner&q=Kyiv"
            }
        },
        {
            "name": "Page Addresses",
            "request": {
                "method": "GET",
                "url": "http://localhost:8000/api/address/page?ownerId=demo-owner&limit=10"
            }
        },
        {
            "name": "Queue Summary",
            "request": {
                "method": "GET",
                "url": "http://localhost:8000/api/address/queue-summary?ownerId=demo-owner"
            }
        }
    ]
}
