#!/usr/bin/env php
<?php
# Copyright (c) 2025 Oleksandr Tishchenko / Marketing America Corp
declare(strict_types=1);

$ttlDays = (int) (getenv('ADDRESS_DELETE_TTL_DAYS') ?: 30);
$pg = new PDO(getenv('PG_DSN'), getenv('PG_USER'), getenv('PG_PASS'), [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);

$pg->beginTransaction();
try {
    $selectStatement = $pg->prepare("SELECT id FROM address_entity WHERE deleted_at IS NOT NULL AND deleted_at < now() - (:ttl || ' day')::interval");
    $selectStatement->execute([':ttl' => (string) $ttlDays]);
    $ids = $selectStatement->fetchAll(PDO::FETCH_COLUMN);

    if ([] !== $ids) {
        $quotedIds = implode(',', array_map(static fn ($id): string => $pg->quote((string) $id), $ids));
        $pg->exec("DELETE FROM address_entity WHERE id IN ($quotedIds)");
    }

    $pg->commit();
    echo 'Purged '.count($ids).' rows from address_entity (TTL '.$ttlDays." days)
";
} catch (Throwable $exception) {
    $pg->rollBack();
    fwrite(STDERR, 'Error: '.$exception->getMessage()."
");
    exit(1);
}
