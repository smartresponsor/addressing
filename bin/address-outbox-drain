#!/usr/bin/env php
<?php
# Copyright (c) 2025 Oleksandr Tishchenko / Marketing America Corp
declare(strict_types=1);


require __DIR__ . '/../vendor/autoload.php';

use App\Addressing\Kernel;
use App\Addressing\Service\Application\AddressOutboxDrainerService;
use JetBrains\PhpStorm\NoReturn;

/**
 * @return void
 */
#[NoReturn] function usage(): void
{
    fwrite(STDERR, "Usage: address-outbox-drain <url> [--limit=200] [--retry=3] [--timeout=5] [--backoff=100]\n");
    exit(2);
}

/**
 * @param array $argv
 * @param string $prefix
 * @param int $default
 * @return int
 */
function read_int_opt(array $argv, string $prefix, int $default): int
{
    foreach ($argv as $arg) {
        if (str_starts_with($arg, $prefix . '=')) {
            $value = substr($arg, strlen($prefix) + 1);
            if (is_numeric($value)) {
                return (int) $value;
            }
        }
    }

    return $default;
}

/** @return array{limit: int, retry: int, timeout: int, backoff: int} */
function drain_opts(array $argv): array
{
    return [
        'limit' => read_int_opt($argv, '--limit', 200),
        'retry' => read_int_opt($argv, '--retry', 3),
        'timeout' => read_int_opt($argv, '--timeout', 5),
        'backoff' => read_int_opt($argv, '--backoff', 100),
    ];
}

$url = $argv[1] ?? null;
if (!is_string($url) || '' === $url || str_starts_with($url, '--')) {
    usage();
}

$options = drain_opts($argv);
$kernel = new Kernel((string) (getenv('APP_ENV') ?: 'prod'), false);
$kernel->boot();
$drainer = $kernel->getContainer()->get(AddressOutboxDrainerService::class);
if (!$drainer instanceof AddressOutboxDrainerService) {
    throw new RuntimeException('address_outbox_drainer_service_unavailable');
}
$count = $drainer->drain(
    $url,
    $options['limit'],
    $options['retry'],
    $options['timeout'],
    $options['backoff'],
);

fwrite(STDOUT, 'Drained: ' . $count . "\n");
