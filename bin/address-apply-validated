#!/usr/bin/env php
<?php
# Copyright (c) 2025 Oleksandr Tishchenko / Marketing America Corp
declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use App\Contract\Message\AddressValidated;
use App\Kernel;
use App\Service\Application\AddressValidatedApplierService;
use JetBrains\PhpStorm\NoReturn;

#[NoReturn] function usage(): void
{
    fwrite(STDERR, "Usage: address-apply-validated <json-file>|- (NDJSON or single JSON)\n");
    exit(2);
}

/**
 * @return list<array<string, mixed>>
 */
function parse_dataset(string $input): array
{
    $dataset = [];
    if (str_contains($input, "\n")) {
        foreach (explode("\n", $input) as $line) {
            $line = trim($line);
            if ('' === $line) {
                continue;
            }

            $decoded = json_decode($line, true);
            if (is_array($decoded)) {
                $dataset[] = $decoded;
            }
        }

        return $dataset;
    }

    $decoded = json_decode($input, true);
    if (!is_array($decoded)) {
        fwrite(STDERR, "Invalid JSON\n");
        exit(2);
    }

    if (isset($decoded[0]) && is_array($decoded[0])) {
        foreach ($decoded as $item) {
            if (is_array($item)) {
                $dataset[] = $item;
            }
        }

        return $dataset;
    }

    return [$decoded];
}

function event_id_opt(array $event, string $camelCaseKey, string $snakeCaseKey): ?string
{
    if (isset($event[$snakeCaseKey]) && is_string($event[$snakeCaseKey]) && '' !== $event[$snakeCaseKey]) {
        return $event[$snakeCaseKey];
    }

    return isset($event[$camelCaseKey]) && is_string($event[$camelCaseKey]) && '' !== $event[$camelCaseKey]
        ? $event[$camelCaseKey]
        : null;
}

/**
 * @param array<string, mixed> $event
 *
 * @return array<string, mixed>
 */
function valid_payload(array $event): array
{
    $payload = $event;
    unset($payload['id'], $payload['ownerId'], $payload['vendorId'], $payload['owner_id'], $payload['vendor_id']);

    return $payload;
}

$arg = $argv[1] ?? null;
if (!$arg) {
    usage();
}

$kernel = new Kernel((string) ($_SERVER['APP_ENV'] ?? getenv('APP_ENV') ?: 'dev'), (bool) ($_SERVER['APP_DEBUG'] ?? getenv('APP_DEBUG') ?: true));
$kernel->boot();
/** @var AddressValidatedApplierService $applier */
$applier = $kernel->getContainer()->get(AddressValidatedApplierService::class);

$handle = ('-' === $arg) ? STDIN : fopen($arg, 'r');
if (!$handle) {
    fwrite(STDERR, "Cannot open input\n");
    exit(2);
}

$buffer = stream_get_contents($handle);
$trimmedInput = trim((string) $buffer);
if ('' === $trimmedInput) {
    fwrite(STDERR, "Empty input\n");
    exit(2);
}

$dataSet = parse_dataset($trimmedInput);
$ok = 0;
$fail = 0;
foreach ($dataSet as $event) {
    try {
        $id = $event['id'] ?? null;
        if (!is_string($id) || '' === $id) {
            $fail++;
            continue;
        }

        $ownerId = event_id_opt($event, 'ownerId', 'owner_id');
        $vendorId = event_id_opt($event, 'vendorId', 'vendor_id');
        $validated = AddressValidated::fromArray(valid_payload($event));
        $applier->apply($id, $validated, $ownerId, $vendorId);
        $ok++;
    } catch (Throwable $throwable) {
        $fail++;
        fwrite(STDERR, 'Error: '.$throwable->getMessage()."\n");
    }
}

fwrite(STDOUT, 'Applied: '.$ok.', Failed: '.$fail."\n");
