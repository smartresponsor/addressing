#!/usr/bin/env php
<?php
# Copyright (c) 2025 Oleksandr Tishchenko / Marketing America Corp
declare(strict_types=1);

require __DIR__.'/address-projection-common.php';

if ($argc < 2) {
    fwrite(STDERR, "Usage: address-projection-sync-since <ISO8601-timestamp>\n");
    exit(2);
}

$since = (string) $argv[1];
$postgres = projection_pdo('PG');
$projectionService = projection_svc();

$sql = 'SELECT * FROM address_entity WHERE (updated_at IS NOT NULL AND updated_at > :since) OR (created_at > :since) ORDER BY updated_at NULLS LAST, created_at';
$statement = $postgres->prepare($sql);
$statement->execute([':since' => $since]);

$count = 0;
while (($row = $statement->fetch(PDO::FETCH_ASSOC)) !== false) {
    if (!is_array($row)) {
        continue;
    }

    $projectionService->upsert(row_address($row));
    ++$count;
}

echo 'Projection synced rows: ' . $count . "\n";
