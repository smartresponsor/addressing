#!/usr/bin/env php
<?php
# Copyright (c) 2025 Oleksandr Tishchenko / Marketing America Corp
declare(strict_types=1);

$count = isset($argv[1]) && is_numeric($argv[1]) ? max(1, (int) $argv[1]) : 50;
$command = escapeshellarg(PHP_BINARY).' '.escapeshellarg(__DIR__.'/console').' address:demo:load --count='.escapeshellarg((string) $count);
passthru($command, $exitCode);

exit($exitCode);
