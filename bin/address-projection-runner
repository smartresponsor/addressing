#!/usr/bin/env php
<?php
# Copyright (c) 2025 Oleksandr Tishchenko / Marketing America Corp
declare(strict_types=1);

require __DIR__.'/address-projection-common.php';

$postgres = projection_pdo('PG');
$projectionService = projection_svc();
$statement = $postgres->query('SELECT * FROM address_entity ORDER BY id ASC');

$count = 0;
while (($row = $statement->fetch(PDO::FETCH_ASSOC)) !== false) {
    if (!is_array($row)) {
        continue;
    }

    $projectionService->upsert(row_address($row));
    ++$count;
}

echo 'Projection applied for ' . $count . " rows.\n";
