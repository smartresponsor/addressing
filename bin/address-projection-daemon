#!/usr/bin/env php
<?php
# Copyright (c) 2025 Oleksandr Tishchenko / Marketing America Corp
declare(strict_types=1);

require __DIR__.'/address-projection-common.php';

function state_path(): string
{
    $path = getenv('ADDRESS_PROJECTION_STATE') ?: '.state/address-projection.watermark';
    $directory = dirname($path);
    if (!is_dir($directory) && !mkdir($directory, 0777, true) && !is_dir($directory)) {
        fwrite(STDERR, 'Cannot create state directory: '.$directory."\n");
        exit(1);
    }

    return $path;
}

function read_watermark(): string
{
    $path = state_path();
    if (!file_exists($path)) {
        return '1970-01-01T00:00:00Z';
    }

    $stateContents = file_get_contents($path);
    $state = false === $stateContents ? '' : trim($stateContents);

    return '' !== $state ? $state : '1970-01-01T00:00:00Z';
}

function write_watermark(string $watermark): void
{
    file_put_contents(state_path(), $watermark);
}

$interval = (int) (getenv('ADDRESS_PROJECTION_INTERVAL_SEC') ?: 5);
$postgres = projection_pdo('PG');
$projectionService = projection_svc();

$watermark = read_watermark();
while (true) {
    $sql = 'SELECT * FROM address_entity WHERE (updated_at IS NOT NULL AND updated_at > :since) OR (created_at > :since) ORDER BY coalesce(updated_at, created_at) ASC LIMIT 1000';
    $statement = $postgres->prepare($sql);
    $statement->execute([':since' => $watermark]);

    $count = 0;
    $newWatermark = $watermark;
    while (($row = $statement->fetch(PDO::FETCH_ASSOC)) !== false) {
        if (!is_array($row)) {
            continue;
        }

        $projectionService->upsert(row_address($row));
        $timestamp = $row['updated_at'] ?? $row['created_at'] ?? $newWatermark;
        $newWatermark = (string) $timestamp;
        ++$count;
    }

    if ($count > 0) {
        write_watermark($newWatermark);
        echo 'Projected ' . $count . ' rows, watermark ' . $newWatermark . "\n";
        continue;
    }

    sleep($interval);
}
